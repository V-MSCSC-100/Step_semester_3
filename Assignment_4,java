import java.util.Scanner;

class BusBay {
    int[] arr;
    int front, size, capacity;

    BusBay(int capacity) {
        this.capacity = capacity;
        arr = new int[capacity];
        front = 0;
        size = 0;
    }

    boolean isEmpty() {
        return size == 0;
    }

    boolean isFull() {
        return size == capacity;
    }

    boolean insertFront(int bus) {
        if (isFull())
            return false;

        front = (front - 1 + capacity) % capacity;
        arr[front] = bus;
        size++;
        return true;
    }

    boolean insertLast(int bus) {
        if (isFull())
            return false;

        int rear = (front + size) % capacity;
        arr[rear] = bus;
        size++;
        return true;
    }

    boolean deleteFront() {
        if (isEmpty())
            return false;

        front = (front + 1) % capacity;
        size--;
        return true;
    }

    boolean deleteLast() {
        if (isEmpty())
            return false;

        size--;
        return true;
    }

    int getFront() {
        if (isEmpty())
            return -1;

        return arr[front];
    }

    int getRear() {
        if (isEmpty())
            return -1;

        return arr[(front + size - 1) % capacity];
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        BusBay b = new BusBay(3);

        System.out.println(b.insertLast(101));
        System.out.println(b.insertLast(102));
        System.out.println(b.insertFront(100));
        System.out.println(b.insertFront(99));
        System.out.println(b.getRear());
        System.out.println(b.isFull());
        System.out.println(b.deleteLast());
        System.out.println(b.insertFront(98));
        System.out.println(b.getFront());

        sc.close();
    }
}
